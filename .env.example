#####################################
#                                   #
#      MANUAL INPUT REQUIRED        #
#                                   #
#####################################

# Agent API keys. Leave as "" to sign in with a subscription instead: run `make login` (or `go-remote login`) once, for
# every workspace. For Claude Code it runs `claude setup-token` on this computer and adds the token it makes to this
# file, as CLAUDE_CODE_OAUTH_TOKEN. Codex and Cursor sign in inside the container, and those logins persist in the
# go-remote-home volume.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional Cursor Agent API key. Leave empty to use `go-remote login cursor` in a running workspace instead.
CURSOR_API_KEY=""

# Fine-grained GitHub PAT scoped to the mounted repo only, with an expiry.
# Permissions: Contents (read and write), Pull requests (read and write), Metadata (read).
# Leave as "" for no GitHub access from inside the container.
GH_TOKEN=""

#####################################
#                                   #
#            OPTIONAL               #
#                                   #
#####################################

# What the QR code opens: web for the Herdr web app (agent chat, terminal and files, for paired devices only),
# or shell for a plain tmux shell in BitBang's own terminal. Takes effect when the workspace next starts.
GR_UI=web

# How the phone's browser connects: force puts BitBang's relay in its link, so it connects through the relay from the
# start; auto lets it try a direct path first. Behind Docker Desktop on a Mac, the direct attempt costs seconds and
# leaves a much slower connection. auto may suit a host the phone can reach directly. Takes effect when the workspace
# next starts.
GR_RELAY=force

# Which agent a web workspace opens in its own tab, for the phone's chat: auto prefers a signed-in Claude Code,
# then Codex, then Cursor; claude, codex or cursor waits for that one. Either starts as soon as its agent is signed
# in; none starts no agent. Takes effect when the workspace next starts.
GR_DEFAULT_AGENT=auto

# The model a new agent starts on, as its own CLI spells it (claude-opus-5-5 or opus for Claude Code), passed as
# --model. Ids differ between agents, so pair it with GR_DEFAULT_AGENT. A `Model:` line in a handoff brief wins over
# it, and a resumed session keeps the model its transcript records. "" = the agent's own default. Takes effect when
# the workspace next starts.
GR_MODEL=""

# PIN the BitBang listener asks for before connecting ("" = no PIN)
BITBANG_PIN=""

# Maximum concurrent shells across all browsers and CLI clients (shell mode)
BITBANG_MAX_SESSIONS=3

# Seconds between watchdog probes. A probe connects to the container's own URL; two failures in a
# row restart the listener with the same URL. Catches listeners the signaling server has dropped,
# for example after the host sleeps. 0 disables the watchdog.
GR_WATCHDOG_INTERVAL=300

# true shows the tappable phone key bar (Esc, ^C, Tab, arrows, PgUp, PgDn) below the tmux status line; false hides
# it. Applies to the tmux shell (shell mode and go-remote attach --shell). Takes effect when the workspace next starts.
GR_KEY_BAR=true

# Phone alerts through ntfy when an agent needs you or finishes ("" = off). Anyone who knows the topic can read
# its alerts, so make it long and random, e.g. openssl rand -hex 16. Alerts name the agent and the repo, never
# what was said.
GR_NTFY_TOPIC=""
# The ntfy server, and an access token for servers that require one
GR_NTFY_SERVER=https://ntfy.sh
GR_NTFY_TOKEN=""

# Container limits
GR_MEMORY=4g
GR_CPUS=2

# Container runtime: runc, or runsc for gVisor on Linux hosts that have it installed
GR_RUNTIME=runc
